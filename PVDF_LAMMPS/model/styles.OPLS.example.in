# STYLE EXAMPLE ONLY. Check against your actual parameter source/exporter.
pair_style lj/cut/coul/long 12.0
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style harmonic
special_bonds lj/coul 0.0 0.0 0.5
pair_modify mix geometric tail no
kspace_style pppm 1.0e-5
# Coefficients, atomic charges, masses, torsion signs and cross terms still REQUIRED.
