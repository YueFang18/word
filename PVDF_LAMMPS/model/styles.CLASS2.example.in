# STYLE EXAMPLE ONLY. PCFF/COMPASS exports must match class2 cross-term conventions.
pair_style lj/class2/coul/long 12.0
bond_style class2
angle_style class2
dihedral_style class2
improper_style class2
special_bonds lj/coul 0.0 0.0 1.0
pair_modify mix sixthpower tail no
kspace_style pppm 1.0e-5
