# OPTIONAL thermal/chemical reaction protocol, NOT a high-voltage oxidation calculation.
# Requires separate charge-style data WITHOUT permanent Bonds/Angles/Dihedrals.
variable validated_reaxff index no
if "${validated_reaxff} != yes" then "print 'Supply and validate a chemically compatible ReaxFF first; see METHODS.zh.md'" "quit 1"
variable data index model/reaxff.data
variable reax_coeffs index model/reaxff.coeffs.in
variable out index results/reaxff
variable T index 300.0
variable dtfs index 0.1
variable seed index 492845
variable neq index 100000
variable nprod index 1000000
units real
atom_style charge
boundary p p p
shell mkdir -p ${out}
log ${out}/log.lammps
pair_style reaxff NULL
read_data ${data}
# File must define pair_coeff and variable elements string in EXACT atom-type order.
include ${reax_coeffs}
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
fix qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff
timestep ${dtfs}
velocity all create ${T} ${seed} mom yes dist gaussian
fix prod all nvt temp ${T} ${T} 100.0
thermo 1000
thermo_style custom step time temp pe etotal press
run ${neq}
reset_timestep 0
fix bonds all reaxff/bonds 1000 ${out}/bonds.reaxff
# Nrepeat=1 avoids long neighbor rebuild requirements from time-averaging species.
fix species all reaxff/species 1 1 1000 ${out}/species.reaxff element ${elements}
dump coords all custom 1000 ${out}/reactive.dump id type q xu yu zu
dump_modify coords sort id
run ${nprod}
write_data ${out}/final.data
print "ReaxFF QEq charges are model charges, not DFT oxidation states; high-temperature rates require mechanism checks before extrapolation."
quit 0
