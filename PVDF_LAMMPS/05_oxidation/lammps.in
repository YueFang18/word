# CLASSICAL configurational sampling ONLY: no oxidation potential or electron removal here.
# Bulk snapshot source. For slabs use adhesion/equilibrium and its boundary conditions.
include common/parameters.in
variable out index results/oxidation
units real
atom_style full
boundary p p p
include common/load.in
fix eq all nvt temp ${T} ${T} ${Tdamp}
run ${neq}
unfix eq
reset_timestep 0
fix prod all nvt temp ${T} ${T} ${Tdamp}
dump coords all custom ${dump_every} ${out}/qm_sampling.dump id mol type q mass xu yu zu
dump_modify coords sort id
variable tim equal time
variable pot equal pe
variable boxV equal vol
fix obs all ave/time ${sample} 1 ${sample} v_tim v_pot v_boxV file ${out}/sampling.dat
run ${nprod}
write_data ${out}/final.data nocoeff
print "Send decorrelated complete-molecule snapshots to DFT. Classical pe and q are NOT ionization energy or oxidation-state charge."
quit 0
