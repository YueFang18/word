# Orthogonal periodic bulk; structure, tensile (x), shear (xy), or elastic.
# elastic jobs: SIX components x +/- strain; all start from SAME reference data/cell.
include common/parameters.in
variable out index results/mechanics
variable mode index structure
variable strain_rate index 1.0e-7
variable maxstrain index 0.05
variable component index 1
variable epsilon index 0.005
variable nrelax index 200000
units real
atom_style full
boundary p p p
include common/load.in
fix eq all nvt temp ${T} ${T} ${Tdamp}
run ${neq}
unfix eq
reset_timestep 0
include common/chain_stats.in
variable tim equal time
variable rho equal density
variable boxV equal vol
# Pressure is positive in compression; tensile Cauchy stress = -pressure.
variable sx equal -pxx*0.101325
variable sy equal -pyy*0.101325
variable sz equal -pzz*0.101325
variable syz equal -pyz*0.101325
variable sxz equal -pxz*0.101325
variable sxy equal -pxy*0.101325
variable Lx0 equal $(lx)
variable Ly0 equal $(ly)
variable Lz0 equal $(lz)
variable ex equal lx/v_Lx0-1.0
variable ey equal ly/v_Ly0-1.0
variable ez equal lz/v_Lz0-1.0
if "${mode} == structure" then "jump SELF structure"
if "${mode} == tensile" then "jump SELF tensile"
if "${mode} == shear" then "jump SELF shear"
if "${mode} == elastic" then "jump SELF elastic"
print "Unknown mechanics mode"
quit 1

label structure
fix prod all nvt temp ${T} ${T} ${Tdamp}
fix obs all ave/time ${sample} 1 ${sample} v_tim v_rho v_boxV v_sx v_sy v_sz file ${out}/structure.dat
run ${nprod}
jump SELF end

label tensile
# x controlled strain; y,z independently relax at target pressure.
fix prod all npt temp ${T} ${T} ${Tdamp} y ${P} ${P} ${Pdamp} z ${P} ${P} ${Pdamp} couple none
fix deformation all deform 1 x erate ${strain_rate} units box remap x
fix obs all ave/time ${sample} 1 ${sample} v_tim v_ex v_ey v_ez v_sx v_sy v_sz file ${out}/stress_strain.dat
thermo_style custom step time temp v_ex v_sx v_sy v_sz density
variable nstrain equal ceil(${maxstrain}/(${strain_rate}*${dtfs}))
run ${nstrain}
jump SELF end

label shear
# Solid small-strain/finite-rate response; for flowing liquid use rheology/nemd.
change_box all triclinic
fix prod all nvt temp ${T} ${T} ${Tdamp}
fix deformation all deform 1 xy erate ${strain_rate} units box remap x
variable gamma equal xy/v_Ly0
fix obs all ave/time ${sample} 1 ${sample} v_tim v_gamma v_sxy file ${out}/shear.dat
variable nstrain equal ceil(${maxstrain}/(${strain_rate}*${dtfs}))
run ${nstrain}
jump SELF end

label elastic
# Voigt order xx yy zz yz xz xy; engineering shear gamma, not tensor epsilon_ij.
if "${component} < 1 || ${component} > 6" then "print 'component must be 1..6'" "quit 1"
variable factor equal 1.0+${epsilon}
if "${component} == 1" then "change_box all x scale ${factor} remap"
if "${component} == 2" then "change_box all y scale ${factor} remap"
if "${component} == 3" then "change_box all z scale ${factor} remap"
if "${component} >= 4" then "change_box all triclinic"
variable dyz equal ${epsilon}*lz
variable dxz equal ${epsilon}*lz
variable dxy equal ${epsilon}*ly
if "${component} == 4" then "change_box all yz delta ${dyz} remap"
if "${component} == 5" then "change_box all xz delta ${dxz} remap"
if "${component} == 6" then "change_box all xy delta ${dxy} remap"
fix prod all nvt temp ${T} ${T} ${Tdamp}
run ${nrelax}
fix obs all ave/time ${sample} 1 ${sample} v_tim v_sx v_sy v_sz v_syz v_sxz v_sxy file ${out}/elastic_stress.dat
print "component=${component} strain=${epsilon} stress_unit=MPa order=xx_yy_zz_yz_xz_xy" file ${out}/elastic_metadata.txt
run ${nprod}

label end
write_data ${out}/final.data nocoeff
quit 0
